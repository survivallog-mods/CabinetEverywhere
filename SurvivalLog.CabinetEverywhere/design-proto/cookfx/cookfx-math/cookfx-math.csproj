<Project Sdk="Microsoft.NET.Sdk">

  <!-- CookingFx 区间公式纯逻辑 spike（tools/railjson-test 同构，独立于主工程）。
       运行：DOTNET_MULTILEVEL_LOOKUP=0 ../../sdk/dotnet/dotnet.exe run（在 cookfx-math/ 下）。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>cookfx-math</AssemblyName>
    <RootNamespace>CookFxMath</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

</Project>
