<Project Sdk="Microsoft.NET.Sdk">

  <!-- RailScopeMath 纯逻辑测试工件（railjson-test 同模式：链源码不复制——直接编译
       ../../SurvivalLog.CabinetEverywhere/RailScopeMath.cs，纯托管零游戏依赖，可独立构建）。
       运行：DOTNET_MULTILEVEL_LOOKUP=0 <dotnet> run · tools/railscope-test · Release -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>railscope-test</AssemblyName>
    <RootNamespace>RailScopeTest</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\SurvivalLog.CabinetEverywhere\RailScopeMath.cs" Link="RailScopeMath.cs" />
  </ItemGroup>

</Project>
