<Project Sdk="Microsoft.NET.Sdk">

  <!-- TradeFx 批1 纯数学测试工件（railjson-test 同构）：链源码不复制，直接编译
       ../../SurvivalLog.CabinetEverywhere/TradeFxMath.cs（纯托管零游戏依赖，可独立构建）。
       运行：DOTNET_MULTILEVEL_LOOKUP=0 sdk/dotnet/dotnet.exe run，项目=tools/tradefx-math-test -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>tradefx-math-test</AssemblyName>
    <RootNamespace>TradeFxMathTest</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\SurvivalLog.CabinetEverywhere\TradeFxMath.cs" Link="TradeFxMath.cs" />
    <Compile Include="..\..\SurvivalLog.CabinetEverywhere\TradeFxJson.cs" Link="TradeFxJson.cs" />
  </ItemGroup>

</Project>
