<Project Sdk="Microsoft.NET.Sdk">

  <!-- CookingFxMath 纯逻辑断言工件（tools/railjson-test 同构）：链源码不复制，直接编译
       ../../SurvivalLog.CabinetEverywhere/CookingFxMath.cs（纯托管零游戏依赖，可独立构建）。
       运行：DOTNET_MULTILEVEL_LOOKUP=0 ../sdk/dotnet/dotnet.exe run，项目=tools/cookfx-math-test。
       T2 起 CookingFx.cs 纯函数段同链（纯变换可离线测，interop 壳实机验证）。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>cookfx-math-test</AssemblyName>
    <RootNamespace>CookFxMathTest</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\SurvivalLog.CabinetEverywhere\CookingFxMath.cs" Link="CookingFxMath.cs" />
    <Compile Include="..\..\SurvivalLog.CabinetEverywhere\CookingFxData.cs" Link="CookingFxData.cs" />
    <Compile Include="..\..\SurvivalLog.CabinetEverywhere\RailJson.cs" Link="RailJson.cs" />
  </ItemGroup>

</Project>
